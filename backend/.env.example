# Copia este archivo como .env y pon tu direccion de base de datos.
#
# OPCION A - PostgreSQL local (como en el modulo de administracion):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rewear
#
# OPCION B - Supabase (en la nube). En Supabase ve a:
#   Project Settings -> Database -> Connection string -> URI
# y pega esa direccion aqui (empieza con postgresql://). El codigo activa SSL solo.
# DATABASE_URL=postgresql://postgres:TU_CLAVE@db.XXXX.supabase.co:5432/postgres
#
PORT=3000
